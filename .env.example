# Bonsale API 連接設定
BONSALE_HOST=
BONSALE_X_API_KEY=
BONSALE_X_API_SECRET=

# 監控的專案 ID（多個以逗號分隔）
BONSALE_PROJECT_ID=

# 3CX Outbound Campaign API
BONSLAE_3CX_OUTBOUND_CAMPAIGN_HOST=

# 排程時間設定（24小時制，格式: HH:MM，多個時段以逗號分隔，最後一個時段為最終檢查模式）
SCHEDULE=09:30,21:50
TIMEZONE=Asia/Taipei

# Discord 通知系統設定
# Discord Bot 連接設定
DISCORD_BOT_TOKEN=
# DISCORD 伺服器 ID
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Pushover 通知系統設定
# Pushover API 端點
PUSHOVER_HOST=https://api.pushover.net/1/messages.json
# Pushover API Token
PUSHOVER_API_TOKEN=
# Pushover User Key
PUSHOVER_USER_KEY=